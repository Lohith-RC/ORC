# ============================================================
# OSCC AI Oral Cancer Detection Platform — Environment Config
# ============================================================
# Copy this file to .env and replace placeholder values.
# NEVER commit .env to version control!

# Application Environment (development | staging | production)
ENVIRONMENT=development

# Database Connection (PostgreSQL or SQLite)
# Local development default: SQLite
DATABASE_URL=sqlite:///oralcancer.db
# Production example:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT Authentication Secret Key
# Generate a strong key: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_THIS_IN_PRODUCTION_USE_RANDOM_32_CHAR_STRING

# Allowed CORS Origins (comma-separated, no spaces)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Server Port (optional, default 8000)
PORT=8000
